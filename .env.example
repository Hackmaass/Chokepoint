FALKORDB_PASSWORD=change-me
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
NVIDIA_API_KEY=nvapi-your-key-here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

DEMO_MODE=1
LLM_RPM_LIMIT=30

# Operations (all optional). Keep comments on their own lines: the loader does not strip trailing comments.
LOG_LEVEL=INFO
# 1 behind Caddy or nginx, so rate limits use the real client address
TRUST_PROXY=0
# requests per minute per client on /api/tools and the demo endpoints
TOOL_RATE_LIMIT=60
# agent runs per minute per client
RUN_RATE_LIMIT=8
# an agent run is stopped between steps after this many seconds
RUN_TIMEOUT_S=300
# only for a UI served from another origin (the Vite dev server)
# CORS_ORIGINS=http://localhost:5173
